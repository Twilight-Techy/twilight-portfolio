# SMTP for the contact form (app/actions/contact.ts)
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use that 16-character value
# as SMTP_PASSWORD. Your normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Where contact form submissions are delivered. Defaults to SMTP_USER.
CONTACT_TO_EMAIL=you@gmail.com

# Optional. GitHub's API allows 60 requests/hour per IP unauthenticated, which
# is shared with other tenants on a serverless host. A fine-grained token with
# read-only access to public repositories lifts that to 5,000/hour.
# The GitHub page works without it; this only makes rate limiting unlikely.
GITHUB_TOKEN=your-github-personal-access-token
